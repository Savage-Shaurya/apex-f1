{
  "name": "apex",
  "version": "0.1.0",
  "private": true,
  "description": "Apex \u2014 unofficial Formula 1 fan platform (PID v1, Phase 1 web)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node scripts/run-tests.mjs",
    "audit:checked": "node scripts/dependency-audit.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\" --ignore-path .gitignore",
    "clean": "turbo run clean && rm -rf node_modules",
    "qa:gate": "pnpm --filter @apex/web qa:gate",
    "qa:gate:quick": "pnpm --filter @apex/web qa:gate:quick"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "comment": "Overrides patch advisories in TRANSITIVE deps that no direct bump can reach. Every entry below was checked against the installed tree \u2014 an override whose selector does not match anything is dead weight that reads like protection and provides none.",
    "overrides": {
      "sharp": "^0.35.4",
      "shell-quote": "1.11.0",
      "postcss": "^8.5.26",
      "js-yaml": "^4.3.2",
      "nanoid@3": "^3.3.18",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@5": "^5.0.12",
      "esbuild@<0.25.0": ">=0.25.0",
      "source-map-js": "1.2.2",
      "postcss-selector-parser@6.0.10": "7.1.6",
      "zod@<4.6.6": "^4.6.6"
    },
    "patchedDependencies": {
      "braces@3.0.3": "patches/braces@3.0.3.patch"
    }
  }
}
