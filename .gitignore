# Dependencies and package-manager stores
node_modules/
.pnpm-store/

# Build output and caches (APEX_NEXT_DIST_DIR builds go to .next-<name>)
.next/
.next-*/
.turbo/
out/
dist/
build/
coverage/
.cache/
.vercel
*.tsbuildinfo
# Generated by `next typegen` / `next dev` / `next build`; its imports depend on the distDir.
next-env.d.ts

# Environment files: only the blank template is tracked
.env
.env.*
!.env.example
*.env.local
*.env.*.local

# Secrets and private credentials. Never commit; keep them in the host's secret store.
.secrets/
*.pem
*.key
*.p12
*.secrets.txt
APEX_SECRETS_BACKUP.txt
codes.txt
Code.txt
secrets.txt
keys.txt

# Database backups and dumps (scripts/ops/backup-db.mjs writes these locally)
backups/
*.dump
*.sql.gz
*.backup
*.bak

# Generated reports and logs
reports/
dependency-security-reports/
apps/web/tests/quality-gate/.reports/
*.log

# Local tooling state
.DS_Store
**/CLAUDE.local.md
supabase/.temp/
_apex-f1-local-dot-git/
