# Apex · environment template
#
# Every variable the source reads is named here, with no values. Copy this to
# `.env.local` for local dev (gitignored), or paste each row into Vercel's
# Project → Settings → Environment Variables before the first deploy. Lines
# marked "GitHub" or "CI" belong in the repository settings or the workflow,
# not in Vercel. Nothing is required to run `pnpm dev` locally.
# Provider availability, quotas and account entitlements must be checked for
# your environment. Optional AI inference is disabled unless explicitly enabled.

# ──────────────────────────────────────────────────────────────────────────
# AI inference · Groq. Model access and billing depend on the account.
# ──────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_INFERENCE_ENABLED=false

# ──────────────────────────────────────────────────────────────────────────
# News aggregation · multi-source F1 coverage
# ──────────────────────────────────────────────────────────────────────────
NEWSAPI_KEY=
GUARDIAN_API_KEY=
NEWSDATA_API_KEY=
GNEWS_API_KEY=
CURRENTS_API_KEY=

# Optional customer weather endpoint key for the provider account in use.
OPENMETEO_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Video · YouTube Data API v3. Verify the actual project quota.
# ──────────────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Imagery needs no keys: driver/team images come from the F1 media CDN
# (media.formula1.com) and circuit/portrait photos from Wikimedia Commons,
# credited in the footer and beside each Commons photo. No stock providers.
# Explicitly enabled administrator HF inference only:
# ──────────────────────────────────────────────────────────────────────────
HUGGINGFACE_TOKEN=
HUGGINGFACE_INFERENCE_ENABLED=false

# OpenF1 real-time access token, if your provider account supports live data.
# Public historical data remains usable without a token.
OPENF1_ACCESS_TOKEN=
OPENF1_REALTIME_ENABLED=false

# ──────────────────────────────────────────────────────────────────────────
# Newsletter · Resend. Verify your account's current delivery/contact limits.
# Without BOTH set, /api/newsletter returns an unavailable response.
# Get a key at https://resend.com/api-keys.
# Create an audience at https://resend.com/audiences and copy its UUID.
# ──────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# Broadcasts require a verified custom-domain sender and the database ledger.
# Optional welcome mail is skipped unless its sender is configured.
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# ──────────────────────────────────────────────────────────────────────────
# Cron secret · required for authenticated /api/cron/* calls in every environment.
# Generate a random value and keep it private. Callers send Authorization: Bearer.
# A caller-supplied x-vercel-cron header does not authenticate a request.
# ──────────────────────────────────────────────────────────────────────────
CRON_SECRET=

# Legacy solo-owner Basic authentication (username apex). Use a distinct random
# value of at least 32 bytes. Prefer named principals below for multiple editors.
ADMIN_PASSWORD=
# Private JSON array, max 32 unique named operators, e.g. objects with username,
# passwordHash and capabilities [read,write,publish,image]. Use only required
# capabilities. Hashes are fixed-format scrypt values provisioned by
# scripts/admin-password-hash.mjs (password supplied through stdin, never argv).
# Do not use the username apex here while legacy ADMIN_PASSWORD is set.
# Named credentials are checked at Proxy and each API; roles/password changes
# invalidate local successful-verification caches. Basic auth has no app logout,
# expiring session or MFA; those require a managed identity integration.
ADMIN_USERS_JSON=
# Admin login sessions (required with ADMIN_USERS_JSON): a private random
# base64url signing secret of at least 32 bytes.
ADMIN_SESSION_SECRET=
# Private JSON object mapping every ADMIN_USERS_JSON username to its own
# 32-character uppercase Base32 TOTP second factor (scripts/admin-mfa-provision.mjs).
ADMIN_MFA_SECRETS_JSON=
# Disabled by default. Only opt in on an undeployed development process bound
# to loopback; Host checks alone cannot establish a caller's network address.
ADMIN_LOCAL_DEV_BYPASS=false

# Dedicated signing secret for anonymous prediction identities; at least 32
# random bytes. Missing configuration disables prediction writes safely.
PREDICTION_COOKIE_SECRET=

# Shared atomic API quotas across deployment instances. Configure before a
# public production launch; required mode fails safely if Redis is unavailable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Redis key scope (DEPLOY.md, audit F-07): only VERCEL_ENV=production (or APEX_ENV=production on a
# self-hosted production server) uses the production budget keys; everything else is apex:<scope>:...
# APEX_ENV=
# APEX_REDIS_SCOPE=
# Every deployment requires a working shared store, including public forms.
# true also disables the coarse fallback during undeployed local development.
# Set false only for local development without a shared store.
DISTRIBUTED_RATE_LIMIT_REQUIRED=true

# ──────────────────────────────────────────────────────────────────────────
# Database · PostgreSQL. Capacity and permissions depend on the environment.
# Use a least-privileged runtime role, distinct from migration/owner credentials.
# TLS verifies the database certificate and hostname. The public Supabase CA
# is bundled. Set an absolute path below only for another trusted private CA.
# https://supabase.com/docs/guides/platform/ssl-enforcement
# ──────────────────────────────────────────────────────────────────────────
DATABASE_URL=
# Native ingestion, grading, newsletter delivery and source maintenance require
# a separate least-privileged job role. Keep its verified-TLS connection private;
# it must not reuse the web runtime identity or a database owner connection.
# Permission grants are applied and tested separately from URL shape validation.
DATABASE_WORKER_URL=
DATABASE_SSL_CA_PATH=

# ──────────────────────────────────────────────────────────────────────────
# Public site URL · the ONLY source of the canonical origin: metadata, OG,
# canonical links, sitemap, robots, JSON-LD and the provider User-Agent.
# Example: https://apex-f1-five.vercel.app (the first deployment; the domain
# changes with the hosting account, so nothing in the code hard-codes it).
# Production (VERCEL_ENV=production, or APEX_STRICT_ENV=true for a local
# rehearsal): REQUIRED. The build and the server start stop if it is missing,
# not https, localhost/loopback, carries credentials, or is a *.vercel.app
# host other than this project's own production host.
# Local dev/preview: optional; unset falls back to http://localhost:3000.
# The GitHub Actions schedulers use the same origin as repository variable
# APEX_SITE_URL; keep the two equal.
# ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=

# Developer performance measurement only: hidden frame-scheduling metrics,
# disabled for normal builds. Does not certify display/GPU rendering quality.
NEXT_PUBLIC_PERFORMANCE_PROBE=0

# ──────────────────────────────────────────────────────────────────────────
# Optional · Ko-fi / Buy Me a Coffee handles for /support page.
# Until both are set the tip-jar buttons land on the provider homepages.
# ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_TIP_JAR_KOFI=
NEXT_PUBLIC_TIP_JAR_BMC=

# ──────────────────────────────────────────────────────────────────────────
# Analytics · PostHog (optional). Leave both keys blank for no analytics: the
# site then shows no cookie banner and the privacy page says no analytics run.
# With NEXT_PUBLIC_POSTHOG_KEY set, the consent banner appears and PostHog
# loads only after a visitor accepts.
# ──────────────────────────────────────────────────────────────────────────
# Public project key used in the browser (consent-gated).
NEXT_PUBLIC_POSTHOG_KEY=
# Optional HTTPS analytics origin; unset uses https://app.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=
# Server-side capture key and host (only used for events with verified consent).
POSTHOG_KEY=
POSTHOG_HOST=

# ──────────────────────────────────────────────────────────────────────────
# Local development and build options. Leave blank in production.
# ──────────────────────────────────────────────────────────────────────────
# Point Jolpica / OpenF1 at a local cache (node scripts/dev/provider-cache.mjs),
# e.g. http://127.0.0.1:4777/jolpica and http://127.0.0.1:4777/openf1. Ignored
# in production unless APEX_ALLOW_LOCAL_PROVIDER_CACHE=1 (local rehearsals only).
JOLPICA_BASE_URL=
OPENF1_BASE_URL=
APEX_ALLOW_LOCAL_PROVIDER_CACHE=0
# Port and folder for scripts/dev/provider-cache.mjs (defaults 4777 and .cache/provider).
PROVIDER_CACHE_PORT=
PROVIDER_CACHE_DIR=
# Build into .next-<name> instead of .next, so a second build does not disturb a running one.
APEX_NEXT_DIST_DIR=
# true applies the production checks (site URL, secrets) to a local production rehearsal.
APEX_STRICT_ENV=false

# ──────────────────────────────────────────────────────────────────────────
# Worker and script options (apps/workers, scripts/)
# ──────────────────────────────────────────────────────────────────────────
# Milliseconds between historical Jolpica requests; at least 8000 (default).
JOLPICA_DELAY_MS=
# 1 also ingests lap-by-lap timing during historical backfills (1996 onward).
INGEST_LAPS=0
# Milliseconds between requests in scripts/build-championship-snapshot.mjs (default 400).
SNAPSHOT_GAP_MS=

# ──────────────────────────────────────────────────────────────────────────
# Scheduled jobs and backups (GitHub Actions). Set these as GitHub repository
# variables/secrets, not in Vercel. See .github/workflows/*.yml.
# ──────────────────────────────────────────────────────────────────────────
# GitHub variable: the public HTTPS origin the refresh workflows call; must
# equal NEXT_PUBLIC_SITE_URL. The workflows send CRON_SECRET (above) as a secret.
APEX_SITE_URL=
# GitHub secrets for db-backup.yml / scripts/ops/backup-db.mjs:
# owner session-pooler URL used by pg_dump (port 5432).
SUPABASE_BACKUP_DB_URL=
# Project URL (https://<ref>.supabase.co) for the Storage API that keeps the dumps.
SUPABASE_URL=
# Service key, used only for the Storage API upload.
SUPABASE_SERVICE_ROLE_KEY=
# Optional PEM of the database CA; unset uses the Supabase root CA bundled in packages/db.
SUPABASE_DB_CA_CERT=
# Local alternative to SUPABASE_DB_CA_CERT: absolute path to the CA file.
SUPABASE_DB_CA_PATH=
# Storage bucket for backups (default apex-backups).
BACKUP_BUCKET=
# Folder holding pg_dump/pg_restore when they are not on PATH.
PG_BIN_DIR=

# CI only (set by .github/workflows/ci.yml for the disposable database smoke test):
# APEX_CI_PG_ADMIN_URL  superuser URL of the throwaway PostgreSQL container
# APEX_CI_PG_CA_PATH    absolute path to that container's self-signed CA
